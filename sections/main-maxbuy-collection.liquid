{{ 'best-sellers.css' | asset_url | stylesheet_tag }}
{{ 'main-maxbuy-collection.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'main-maxbuy-collection.min.js' | asset_url }}" defer></script>
{% liquid
  assign independent_source = false
  if section.settings.source_collection != blank
    assign independent_source = true
    if collection.handle != section.settings.source_collection.handle
      assign collection = section.settings.source_collection
    endif
  endif
  assign heading_tag = section.settings.heading_tag | default: 'auto'
  if heading_tag == 'auto'
    if independent_source
      assign heading_tag = 'h2'
    else
      assign heading_tag = 'h1'
    endif
  endif
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign form_id = 'CollectionFilters-' | append: section.id
  assign category_param = section.settings.category_param | default: 'filter.p.product_type'
  assign category_filter = collection.filters | where: 'param_name', category_param | first
  assign brand_param = section.settings.brand_param | default: 'filter.p.vendor'
  assign vendor_filter = collection.filters | where: 'param_name', brand_param | first
  assign pool_handle = section.settings.pool_collection.handle | default: 'all'
  assign pool_url = routes.collections_url | append: '/' | append: pool_handle
  assign is_pool = false
  if collection.handle == pool_handle
    assign is_pool = true
  endif
  assign filter_count = 0
  for filter in collection.filters
    assign filter_count = filter_count | plus: filter.active_values.size
    if filter.type == 'price_range'
      if filter.min_value.value != nil or filter.max_value.value != nil
        assign filter_count = filter_count | plus: 1
      endif
    endif
  endfor
  assign entry = nil
  unless is_pool or independent_source
    if filter_count == 0
      for block in section.blocks
        if block.type == 'entry' and block.settings.enable_pool_transition
          if block.settings.source_collection.handle == collection.handle and block.settings.value != blank
            assign entry = block
            break
          endif
        endif
      endfor
    endif
  endunless
  assign catalog_mode = is_pool
  if independent_source
    assign catalog_mode = false
  endif
  assign form_action = collection.url
  if independent_source == false and is_pool or entry != nil
    assign catalog_mode = true
    assign form_action = pool_url
  endif
  if entry != nil
    assign filter_count = filter_count | plus: 1
  endif
  assign has_sidebar = section.settings.enable_filtering
  assign clear_url = form_action | append: '?sort_by=' | append: sort_by
  capture catalog_heading
    if is_pool and independent_source == false
      render 'maxbuy-catalog-heading', category_filter: category_filter, vendor_filter: vendor_filter
    else
      echo collection.title
    endif
  endcapture
  assign promotion_link = section.settings.promotion_link
  if promotion_link == blank
    assign promotion_link = '#CollectionHeading-' | append: section.id
  endif
%}
{% style %}
  @font-face { font-family: 'Maxbuy Collection Public Sans'; font-style: normal; font-weight: 700; font-display: swap; src: url({{ 'best-sellers-public-sans-bold.ttf' | asset_url }}) format('truetype'); }
  #shopify-section-{{ section.id }} { background: {{ section.settings.background }}; }
  #Collection-{{ section.id }} { --collection-columns: {{ section.settings.desktop_products_per_row }}; --collection-mobile-columns: {{ section.settings.mobile_products_per_row }}; --collection-motion: {% if section.settings.enable_motion %}{{ section.settings.motion_duration }}ms{% else %}0ms{% endif %}; --collection-delay: {{ section.settings.motion_delay }}ms; --collection-background: {{ section.settings.background }}; }
{% endstyle %}
<maxbuy-collection id="Collection-{{ section.id }}" class="maxbuy-collection best-sellers" data-section-id="{{ section.id }}" data-independent-source="{{ independent_source }}" data-pool-url="{{ pool_url }}" data-catalog-mode="{{ catalog_mode }}" data-price-error="{{ 'maxbuy_catalog.price_error' | t | escape }}" data-collection-url="{{ collection.url }}" data-collection-handle="{{ collection.handle }}" data-product-count="{{ collection.all_products_count }}">
  <div data-collection-results>
  <div class="maxbuy-collection__intro">
    {% assign collection_breadcrumb_label = collection.title %}
    {% if collection.handle == 'all' %}{% assign collection_breadcrumb_label = 'All' %}{% endif %}
    {% if section.settings.show_breadcrumbs != false %}
      {% render 'breadcrumbs', complete_collection_schema: true, collection_breadcrumb_label: collection_breadcrumb_label, collection: collection %}
    {% endif %}
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":{{ 'general.breadcrumbs.home' | t | json }},"item":{{ request.origin | append: routes.root_url | json }}},{"@type":"ListItem","position":2,"name":"Collections","item":{{ request.origin | append: routes.collections_url | json }}},{"@type":"ListItem","position":3,"name":{{ collection_breadcrumb_label | json }},"item":{{ request.origin | append: collection.url | json }}}]}</script>
    {% if section.settings.show_promotion %}
      <div class="maxbuy-collection__promotion">
        {% if section.settings.promotion_image %}
          <picture>
            {% if section.settings.promotion_image_mobile %}<source media="(max-width: 767px)" srcset="{{ section.settings.promotion_image_mobile | image_url: width: 900 }}">{% endif %}
            {{ section.settings.promotion_image | image_url: width: 2464 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600, 900, 1232, 1848, 2464', sizes: '(min-width: 1312px) 1232px, calc(100vw - 40px)', alt: section.settings.promotion_image.alt }}
          </picture>
        {% else %}
          <img class="maxbuy-collection__promotion-desktop" src="{{ 'maxbuy-collection-promotion.png' | asset_url }}" alt="" width="2048" height="454" loading="eager" fetchpriority="high">
          <div class="maxbuy-collection__promotion-mobile" aria-hidden="true">
            <div class="maxbuy-collection__promotion-art maxbuy-collection__promotion-art--middle"><img src="{{ 'maxbuy-collection-promotion-mobile-art.png' | asset_url }}" width="2528" height="560" alt="" loading="eager"></div>
            <div class="maxbuy-collection__promotion-art maxbuy-collection__promotion-art--top"><img src="{{ 'maxbuy-collection-promotion-mobile-art.png' | asset_url }}" width="2528" height="560" alt="" loading="eager"></div>
            <div class="maxbuy-collection__promotion-art maxbuy-collection__promotion-art--bottom"><img src="{{ 'maxbuy-collection-promotion-mobile-art.png' | asset_url }}" width="2528" height="560" alt="" loading="eager"></div>
            <div class="maxbuy-collection__promotion-glow"><img src="{{ 'maxbuy-collection-promotion-mobile-glow.svg' | asset_url }}" width="631" height="460.238" alt=""></div>
          </div>
        {% endif %}
        <div class="maxbuy-collection__promotion-copy">
          {% if section.settings.promotion_eyebrow != blank %}<p>{{ section.settings.promotion_eyebrow | escape }}</p>{% endif %}
          {% if section.settings.promotion_heading != blank %}<h2>{{ section.settings.promotion_heading | escape }}</h2>{% endif %}
          {% if section.settings.promotion_button != blank %}<a href="{{ promotion_link }}"><img class="maxbuy-collection__promotion-cart" src="{{ 'maxbuy-collection-promotion-cart.svg' | asset_url }}" width="8.22184" height="8.22184" alt="">{{ section.settings.promotion_button | escape }}</a>{% endif %}
        </div>
      </div>
    {% endif %}
    {% if section.settings.show_description and collection.description != blank %}<div class="maxbuy-collection__description rte">{{ collection.description }}</div>{% endif %}
  </div>
    <div class="maxbuy-collection__layout{% unless has_sidebar %} maxbuy-collection__layout--full{% endunless %}">
      {% if has_sidebar %}
        <dialog class="maxbuy-collection__sidebar" id="CollectionFiltersDialog-{{ section.id }}" aria-labelledby="FiltersTitle-{{ section.id }}" open>
          <div class="maxbuy-collection__filter-header"><h2 id="FiltersTitle-{{ section.id }}"><img class="maxbuy-collection__filter-icon" src="{{ 'maxbuy-collection-filter.svg' | asset_url }}" width="16" height="16" alt="">{{ section.settings.filters_heading | escape }}</h2><button type="button" data-filters-close aria-label="{{ 'accessibility.close' | t | escape }}"><img src="{{ 'maxbuy-collection-close.svg' | asset_url }}" width="22.0002" height="22" alt=""></button></div>
          <form id="{{ form_id }}" action="{{ form_action }}" method="get" data-collection-form>
            {% if catalog_mode %}
              {% if is_pool %}
                {% if category_filter %}{% render 'maxbuy-collection-filter', filter: category_filter, section: section, index: 'category' %}{% endif %}
              {% else %}
                {% render 'maxbuy-catalog-dimension', dimension: 'category', filter: category_filter, param_name: category_param, heading: section.settings.category_heading, section: section, entry: entry, is_pool: is_pool %}
              {% endif %}
              {% render 'maxbuy-catalog-dimension', dimension: 'brand', directory_links: section.settings.brand_menu.links, filter: vendor_filter, param_name: brand_param, heading: section.settings.brand_heading, section: section, entry: entry, is_pool: is_pool %}
            {% else %}
              {% if category_filter %}{% render 'maxbuy-collection-filter', filter: category_filter, section: section, index: 'category', hide_count: true %}{% endif %}
              {% if vendor_filter %}{% render 'maxbuy-collection-filter', filter: vendor_filter, section: section, index: 'brand', hide_count: true %}{% endif %}
            {% endif %}
            {% comment %}Keep platform data, but present the main groups in a stable order.{% endcomment %}
            {% for filter in collection.filters %}{% if filter.type == 'price_range' %}{% render 'maxbuy-collection-filter', filter: filter, section: section, index: forloop.index %}{% endif %}{% endfor %}
            {% for filter in collection.filters %}{% if filter.param_name == section.settings.color_param %}{% render 'maxbuy-collection-filter', filter: filter, section: section, index: forloop.index %}{% endif %}{% endfor %}
            {% for filter in collection.filters %}{% if filter.param_name == 'filter.v.availability' %}{% render 'maxbuy-collection-filter', filter: filter, section: section, index: forloop.index %}{% endif %}{% endfor %}
            {% for filter in collection.filters %}
              {% if filter.param_name == category_param or filter.param_name == brand_param or filter.param_name == section.settings.color_param or filter.param_name == 'filter.v.availability' or filter.type == 'price_range' %}{% continue %}{% endif %}
              {% render 'maxbuy-collection-filter', filter: filter, section: section, index: forloop.index %}
            {% endfor %}
            <button class="maxbuy-collection__apply" type="submit">{{ 'products.facets.apply' | t }}</button>
          </form>
          {% unless catalog_mode %}
            {% if section.settings.category_menu != blank or section.settings.brand_menu != blank %}
              <details class="maxbuy-collection__filter"><summary>{{ 'sections.collection_list.view_collection' | t }}</summary>
                <nav aria-label="{{ 'sections.collection_list.view_collection' | t | escape }}"><ul class="maxbuy-collection__categories" role="list">
                  {% render 'maxbuy-collection-categories', links: section.settings.category_menu.links %}
                  {% render 'maxbuy-collection-categories', links: section.settings.brand_menu.links %}
                </ul></nav>
              </details>
            {% endif %}
            <a href="{{ pool_url }}">{{ 'quick_order_list.all_products' | t }}</a>{% endunless %}
          <div class="maxbuy-collection__filter-actions">
            <button class="maxbuy-collection__show-results" type="submit" form="{{ form_id }}">{{ section.settings.apply_label | escape }}</button>
            <a class="maxbuy-collection__clear" href="{{ clear_url }}" data-filters-clear>{{ 'templates.search.clear_all' | t }}</a>
          </div>
        </dialog>
      {% else %}
        <form id="{{ form_id }}" action="{{ form_action }}" method="get" data-collection-form hidden></form>
      {% endif %}
      <div class="maxbuy-collection__main">
        <div class="maxbuy-collection__toolbar" {% if is_pool and independent_source == false %}data-document-title="{{ catalog_heading | strip | escape }} – {{ shop.name | escape }}"{% endif %}>
          <{{ heading_tag }} class="maxbuy-collection__heading" id="CollectionHeading-{{ section.id }}" tabindex="-1" data-collection-heading>{{ catalog_heading | strip | escape }}</{{ heading_tag }}>
          <div class="maxbuy-collection__controls">
            {% if has_sidebar %}<button type="button" data-filters-open aria-controls="CollectionFiltersDialog-{{ section.id }}" aria-expanded="false"><img src="{{ 'maxbuy-collection-filter.svg' | asset_url }}" width="16" height="16" alt="">{{ section.settings.filters_heading | escape }}{% if filter_count > 0 %} ({{ filter_count }}){% endif %}</button>{% endif %}
            {% if section.settings.enable_sorting %}
              <div class="maxbuy-collection__sort">
                <label for="CollectionSort-{{ section.id }}" id="CollectionSortLabel-{{ section.id }}">{{ 'products.facets.sort_by_label' | t }}</label>
                <select id="CollectionSort-{{ section.id }}" name="sort_by" form="{{ form_id }}" data-collection-sort>{% for option in collection.sort_options %}<option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}</select>
                <details class="maxbuy-collection__sort-dropdown" data-sort-dropdown>
                  <summary aria-labelledby="CollectionSortLabel-{{ section.id }} CollectionSortValue-{{ section.id }}"><span id="CollectionSortValue-{{ section.id }}" data-sort-value>{% for option in collection.sort_options %}{% if option.value == sort_by %}{{ option.name | escape }}{% endif %}{% endfor %}</span><span class="maxbuy-collection__sort-arrow" aria-hidden="true"></span></summary>
                  <div class="maxbuy-collection__sort-options" role="group" aria-labelledby="CollectionSortLabel-{{ section.id }}">
                    {% for option in collection.sort_options %}<button type="button" data-sort-option="{{ option.value | escape }}" aria-pressed="{% if option.value == sort_by %}true{% else %}false{% endif %}"><span>{{ option.name | escape }}</span><span class="maxbuy-collection__sort-check" aria-hidden="true">✓</span></button>{% endfor %}
                  </div>
                </details>
              </div>
            {% else %}<input type="hidden" name="sort_by" form="{{ form_id }}" value="{{ sort_by }}">{% endif %}
          </div>
          <noscript><button class="maxbuy-collection__apply" type="submit" form="{{ form_id }}">{{ section.settings.apply_label | escape }}</button></noscript>
        </div>
        <div class="maxbuy-collection__result-meta"><p data-result-count data-count="{{ collection.products_count }}">{{ 'products.facets.product_count_simple' | t: count: collection.products_count }}</p>{% if filter_count > 0 or collection.products_count == 0 %}<a href="{{ clear_url }}" data-collection-link>{{ 'templates.search.clear_all' | t }}</a>{% endif %}</div>
        {% if filter_count > 0 %}
          <ul class="maxbuy-collection__active" aria-label="{{ 'products.facets.filter_by_label' | t | escape }}" role="list">
            {% if entry != nil %}<li><a href="{{ clear_url }}" data-collection-link>{{ entry.settings.label | default: entry.settings.value | escape }} <span aria-hidden="true">×</span><span class="sr-only">{{ 'accessibility.remove' | t }}</span></a></li>{% endif %}
            {% for filter in collection.filters %}
              {% for value in filter.active_values %}<li><a href="{{ value.url_to_remove }}" data-collection-link>{{ filter.label | escape }}: {{ value.label | escape }} <span aria-hidden="true">×</span><span class="sr-only">{{ section.settings.remove_filter_label | escape }}</span></a></li>{% endfor %}
              {% if filter.type == 'price_range' %}{% if filter.min_value.value != nil or filter.max_value.value != nil %}<li><a href="{{ filter.url_to_remove }}" data-collection-link>{{ filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }} <span aria-hidden="true">×</span></a></li>{% endif %}{% endif %}
            {% endfor %}
          </ul>
        {% endif %}
        {% paginate collection.products by section.settings.products_per_page %}
          <div class="maxbuy-collection__grid" data-collection-grid x-intersect.once="$store.xCustomerEvent.fire('list_product_viewed', $el, { list: { id: 'collection', title: {{ collection.title | json | escape }} } })">
            {% for product in collection.products %}
              {% render 'best-sellers-card', product: product, section: section, collection: collection, index: forloop.index, collection_card: true %}
            {% else %}
              <div class="maxbuy-collection__empty"><p>{{ 'sections.collection_template.empty' | t }}</p>{% if filter_count > 0 or collection.products_count == 0 %}<a href="{{ clear_url }}" data-collection-link>{{ 'templates.search.clear_all' | t }}</a>{% endif %}</div>
            {% endfor %}
          </div>
          {% if paginate.pages > 1 %}
            <nav class="maxbuy-collection__pagination" aria-label="{{ 'general.pagination.label' | t | escape }}">
              {% if paginate.previous %}<a href="{{ paginate.previous.url }}" data-collection-link data-page-link aria-label="{{ 'general.pagination.previous' | t | escape }}">‹</a>{% endif %}
              {% for part in paginate.parts %}{% if part.is_link %}<a href="{{ part.url }}" data-collection-link data-page-link aria-label="{{ 'general.pagination.page' | t: number: part.title | escape }}">{{ part.title }}</a>{% elsif part.title == paginate.current_page %}<span aria-current="page">{{ part.title }}</span>{% else %}<span>{{ part.title }}</span>{% endif %}{% endfor %}
              {% if paginate.next %}<a href="{{ paginate.next.url }}" data-collection-link data-page-link aria-label="{{ 'general.pagination.next' | t | escape }}">›</a>{% endif %}
            </nav>
          {% endif %}
        {% endpaginate %}
      </div>
    </div>
  </div>
  <p class="maxbuy-collection__status sr-only" role="status" aria-live="polite" data-collection-status></p>
  <div class="maxbuy-collection__error" role="alert" hidden><p>{{ section.settings.error_label | escape }}</p><button type="button" data-collection-retry>{{ section.settings.retry_label | escape }}</button><a href="{{ collection.url }}" data-collection-reload>{{ section.settings.reload_label | escape }}</a></div>
</maxbuy-collection>
{% schema %}
{
  "name": "Maxbuy collection",
  "tag": "section",
  "class": "maxbuy-collection-section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "presets": [
    {
      "name": "Maxbuy collection"
    }
  ],
  "settings": [
    {
      "type": "collection",
      "id": "source_collection",
      "label": "Display collection",
      "info": "Choose the products for this section. Leave blank to use the current page collection. Selected collections filter, sort and paginate independently."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Automatic (page: H1, selected collection: H2)" },
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" }
      ],
      "info": "Keep one H1 per page. If every section uses a selected collection, set the first section to H1."
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "header",
      "content": "Unified catalog"
    },
    {
      "type": "collection",
      "id": "pool_collection",
      "label": "Unified product pool",
      "info": "Defaults to /collections/all. Verify collection rules and market visibility before use."
    },
    {
      "type": "select",
      "id": "category_param",
      "label": "Category source",
      "default": "filter.p.product_type",
      "options": [
        {
          "value": "filter.p.product_type",
          "label": "Product type"
        },
        {
          "value": "filter.p.m.custom.catalog_categories",
          "label": "custom.catalog_categories (list text)"
        }
      ]
    },
    {
      "type": "select",
      "id": "brand_param",
      "label": "Brand source",
      "default": "filter.p.vendor",
      "options": [
        {
          "value": "filter.p.vendor",
          "label": "Vendor"
        },
        {
          "value": "filter.p.m.custom.brand",
          "label": "custom.brand (single line text)"
        }
      ],
      "info": "If Vendor represents a supplier, use a dedicated brand field. Recheck entry mappings after changing sources."
    },
    {
      "type": "text",
      "id": "color_param",
      "label": "Color filter parameter",
      "default": "filter.v.option.color",
      "info": "Use the exact native parameter for the existing color source."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#f7f7f7"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 6,
      "max": 48,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "desktop_products_per_row",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_products_per_row",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_label_badges",
      "label": "Show product tag badges",
      "default": true
    },
    {
      "type": "textarea",
      "id": "best_sellers_badge_label",
      "label": "Badge tags (one per line)",
      "default": "Special Offer\nNew\nHOT"
    },
    {
      "type": "header",
      "content": "Promotion banner"
    },
    {
      "type": "checkbox",
      "id": "show_promotion",
      "label": "Show promotion",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "promotion_image",
      "label": "Desktop image",
      "info": "Recommended: 2464 × 486. Leave empty to use the design image."
    },
    {
      "type": "image_picker",
      "id": "promotion_image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "promotion_eyebrow",
      "label": "Intro text",
      "default": "Get ready for the new term"
    },
    {
      "type": "text",
      "id": "promotion_heading",
      "label": "Heading",
      "default": "Up to 30% off"
    },
    {
      "type": "text",
      "id": "promotion_button",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "promotion_link",
      "label": "Button link",
      "info": "Defaults to this collection's product list."
    },
    {
      "type": "header",
      "content": "Filters and sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable Shopify filters",
      "default": true,
      "info": "Configure filter types and values in Shopify Search & Discovery."
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "expand_filters",
      "label": "Expand filter groups by default",
      "default": true
    },
    {
      "type": "link_list",
      "id": "category_menu",
      "label": "Collection navigation menu",
      "info": "Legacy collection links on unmapped landing pages. Product Categories uses the native Search & Discovery source; this menu is not duplicated as filter options."
    },
    {
      "type": "text",
      "id": "category_heading",
      "label": "Category heading",
      "default": "Product Categories"
    },
    {
      "type": "link_list",
      "id": "brand_menu",
      "label": "Brands collection menu",
      "info": "Complete menu directory shown on every catalog page. Entry mapping blocks connect menu collections to exact native filter values; unmapped items stay visible but disabled."
    },
    {
      "type": "text",
      "id": "brand_unavailable_label",
      "label": "Brand filter unavailable message",
      "default": "Brand filtering is currently unavailable."
    },
    {
      "type": "text",
      "id": "brand_heading",
      "label": "Brands heading",
      "default": "Brands"
    },
    {
      "type": "text",
      "id": "price_from_label",
      "label": "Price from label",
      "default": "From"
    },
    {
      "type": "text",
      "id": "price_to_label",
      "label": "Price to label",
      "default": "To"
    },
    {
      "type": "text",
      "id": "remove_filter_label",
      "label": "Remove filter label",
      "default": "Remove filter"
    },
    {
      "type": "text",
      "id": "filters_heading",
      "label": "Filters heading",
      "default": "Filters"
    },
    {
      "type": "text",
      "id": "best_sellers_button_label",
      "label": "Product card button",
      "default": "Shop Now"
    },
    {
      "type": "text",
      "id": "apply_label",
      "label": "Apply button",

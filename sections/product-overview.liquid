{%- liquid
  assign overview_field = product.metafields.custom.product_overview
  assign overview_items = nil
  if overview_field.type == 'list.metaobject_reference'
    assign overview_items = overview_field.value
  endif
-%}
{%- capture overview_content -%}
  {%- for item in overview_items -%}
    {%- liquid
      assign heading = item.heading.value | strip
      assign heading_id = 'ProductOverview-' | append: section.id | append: '-' | append: forloop.index
      assign content_text = ''
      if item.content.type == 'rich_text_field' and item.content.value != blank
        assign content_text = item.content | metafield_text | strip
      endif
    -%}
    {%- capture specification_content -%}
      {%- if item.specifications.type == 'list.metaobject_reference' -%}
        {%- render 'product-overview-specifications',
          specifications: item.specifications.value,
          columns: section.settings.specification_columns,
          heading_id: heading_id
        -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- if heading != blank -%}
      {%- if content_text != blank or specification_content != blank -%}
        <div class="product-overview__item{% if section.settings.enable_animation %} anm-fade-element{% endif %}"{% if section.settings.enable_animation %} data-fade-on-intersect{% endif %}>
          <h2 class="product-overview__heading" id="{{ heading_id }}">{{ heading | escape }}</h2>
          {%- if content_text != blank -%}
            <div class="product-overview__body rte">
              {{- item.content | metafield_tag | replace: '<h1', '<h3' | replace: '</h1>', '</h3>' | replace: '<h2', '<h3' | replace: '</h2>', '</h3>' -}}
            </div>
          {%- endif -%}
          {{- specification_content -}}
        </div>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if overview_content != blank -%}
  {{ 'product-overview.css' | asset_url | stylesheet_tag }}
  {%- liquid
    assign specification_font = section.settings.specification_font
    assign specification_font_bold = specification_font | font_modify: 'weight', '700'
  -%}
  {%- style -%}
    {{ specification_font | font_face: font_display: 'swap' }}
    {{ specification_font_bold | font_face: font_display: 'swap' }}
    #shopify-section-{{ section.id }} {
      --overview-padding-top: {{ section.settings.padding_top }}px;
      --overview-padding-bottom: {{ section.settings.padding_bottom }}px;
      --overview-spec-font: {{ specification_font.family }}, {{ specification_font.fallback_families }};
      --overview-animation-duration: {{ section.settings.animation_duration }}ms;
      --overview-animation-delay: {{ section.settings.animation_delay }}ms;
    }
  {%- endstyle -%}
  <div class="product-overview {{ section.settings.section_width }}" data-product-overview="{{ product.id }}">
    <div class="product-overview__card" id="ProductOverview-{{ section.id }}">
      {{- overview_content -}}
      {%- if section.settings.show_product_details -%}
        {% render 'product-overview-details', product: product, section: section %}
      {%- endif -%}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="page-width product-overview__empty">
    <p>Product Overview: select active Product Overview Item entries in this product’s custom.product_overview metafield. Each entry needs a heading and either rich text content or specifications with a label and value.</p>
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Product Overview",
  "tag": "section",
  "class": "maximize-section section-product-overview",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "Reads custom.product_overview from the current product. Entries and their nested specifications follow the order saved on the product. Draft and empty entries are hidden." },
    { "type": "select", "id": "section_width", "label": "Section width", "options": [{ "value": "page-width", "label": "Page width" }, { "value": "full-width", "label": "Full width" }], "default": "page-width" },
    { "type": "header", "content": "Specifications" },
    { "type": "select", "id": "specification_columns", "label": "Desktop columns", "options": [{ "value": "1", "label": "One" }, { "value": "2", "label": "Two" }], "default": "2", "info": "Mobile always displays one column, preserving list order." },
    { "type": "font_picker", "id": "specification_font", "label": "Specification font", "default": "outfit_n4" },
    { "type": "header", "content": "Product details" },
    { "type": "checkbox", "id": "show_product_details", "label": "Show SKU, collections, tags and brand", "default": true },
    { "type": "text", "id": "sku_label", "label": "SKU label", "default": "SKU" },
    { "type": "text", "id": "categories_label", "label": "Collections label", "default": "Categories" },
    { "type": "text", "id": "tags_label", "label": "Tags label", "default": "Tags" },
    { "type": "text", "id": "brand_label", "label": "Brand label", "default": "Brand" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "header", "content": "Animation" },
    { "type": "checkbox", "id": "enable_animation", "label": "Enable content fade-in", "default": false },
    { "type": "range", "id": "animation_duration", "label": "Duration", "min": 100, "max": 1000, "step": 50, "unit": "ms", "default": 300 },
    { "type": "range", "id": "animation_delay", "label": "Delay", "min": 0, "max": 1000, "step": 50, "unit": "ms", "default": 0 }
  ],
  "presets": [{ "name": "Product Overview" }]
}
{% endschema %}

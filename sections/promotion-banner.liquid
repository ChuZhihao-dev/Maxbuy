{% liquid
  assign banner_image = section.settings.image | default: section.settings.mobile_image
  assign mobile_image = section.settings.mobile_image | default: banner_image
  assign desktop_ratio = banner_image.aspect_ratio | default: 5.0
  assign mobile_ratio = mobile_image.aspect_ratio | default: desktop_ratio
  if section.settings.mobile_design_layout
    assign mobile_ratio = 1
  endif
  assign banner_heading_semibold = section.settings.banner_text_font | font_modify: 'weight', '600'
  assign image_loading = 'lazy'
  if section.index == 1 and section.location == 'template'
    assign image_loading = 'eager'
  endif
  assign has_content = false
  if section.settings.subheading != blank or section.settings.heading != blank or section.settings.text != blank or section.settings.button_label != blank
    assign has_content = true
  endif
  assign link_label = section.settings.heading | default: banner_image.alt
  if link_label == blank
    assign link_label = 'accessibility.image_link' | t
  endif
  assign banner_heading_bold = section.settings.banner_text_font | font_modify: 'weight', 'bold'
%}
{{ 'section-promotion-banner.css' | asset_url | stylesheet_tag }}
{% style %}
  {{ section.settings.banner_text_font | font_face: font_display: 'swap' }}
  {{ banner_heading_bold | font_face: font_display: 'swap' }}
  {{ banner_heading_semibold | font_face: font_display: 'swap' }}
  @font-face {
    font-family: 'Promotion Banner Public Sans';
    src: url('{{ 'promotion-banner-public-sans.ttf' | asset_url }}') format('truetype');
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
  }
  #PromotionBanner-{{ section.id }} {
    --pb-text-font: {{ section.settings.banner_text_font.family }}, {{ section.settings.banner_text_font.fallback_families }};
    --pb-button-font: 'Promotion Banner Public Sans', sans-serif;
    --pb-radius: {{ section.settings.corner_radius }}px;
    --pb-ratio: {{ mobile_ratio }};
    --pb-height: {% if section.settings.mobile_height == 'adapt' %}auto{% else %}{{ section.settings.mobile_height }}px{% endif %};
    --pb-position: {{ section.settings.mobile_content_position }};
    --pb-align: {{ section.settings.mobile_content_alignment }};
    padding-top: calc({{ section.settings.padding_top }}px * var(--mobile-padding-ratio));
    padding-bottom: calc({{ section.settings.padding_bottom }}px * var(--mobile-padding-ratio));
  }
  @media (min-width: 768px) {
    #PromotionBanner-{{ section.id }} {
      --pb-ratio: {{ desktop_ratio }};
      --pb-height: {% if section.settings.desktop_height == 'adapt' %}auto{% else %}{{ section.settings.desktop_height }}px{% endif %};
      --pb-position: {{ section.settings.desktop_content_position }};
      --pb-align: {{ section.settings.desktop_content_alignment }};
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}
<div id="PromotionBanner-{{ section.id }}" class="promotion-banner {{ section.settings.section_width }}{% if section.settings.mobile_design_layout %} promotion-banner--mobile-design{% endif %}{% if section.settings.mobile_image != blank %} promotion-banner--mobile-image{% endif %}">
  <div class="promotion-banner__frame color-{{ section.settings.color_scheme_light }} dark-color-{{ section.settings.color_scheme_dark }}">
    <div class="promotion-banner__media">
      {% if banner_image != blank %}
        {% render 'image-new', image: banner_image, image_mobile: section.settings.mobile_image, image_class: 'promotion-banner__image', loading: image_loading, sizes: '100vw' %}
      {% else %}
        <div class="promotion-banner__placeholder">{% render 'placeholder-image', image_type: 'banner' %}</div>
        {% if section.settings.mobile_design_layout %}
          <img class="promotion-banner__reference promotion-banner__image" src="{{ 'promotion-banner-reference.png' | asset_url }}" width="2528" height="560" loading="{{ image_loading }}" alt="">
        {% endif %}
      {% endif %}
    </div>
    <div class="promotion-banner__shade scheme-image-overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
    {% if section.settings.image_link != blank %}
      <a class="promotion-banner__link" href="{{ section.settings.image_link }}" aria-label="{{ link_label | escape }}"{% if section.settings.open_new_window_image %} target="_blank" rel="noopener noreferrer"{% endif %}></a>
    {% endif %}
    {% if has_content %}
      <div class="promotion-banner__content">
        <div class="promotion-banner__copy" data-maxbuy-reveal="text">
          {% if section.settings.subheading != blank %}<p class="promotion-banner__subheading">{{ section.settings.subheading | escape }}</p>{% endif %}
          {% if section.settings.heading != blank %}<h2 class="promotion-banner__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
          {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
          {% if section.settings.button_label != blank %}
            <div class="promotion-banner__button-wrapper">
              <a class="promotion-banner__button"
                {% if section.settings.button_link != blank %}
                  href="{{ section.settings.button_link }}"
                  {% if section.settings.open_new_window_button %}target="_blank" rel="noopener noreferrer"{% endif %}
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
              >
                <picture class="promotion-banner__button-icon">
                  {% if section.settings.mobile_design_layout %}<source media="(max-width: 767px)" srcset="{{ 'promotion-banner-cart-mobile.svg' | asset_url }}">{% endif %}
                  <img src="{{ 'promotion-banner-cart.svg' | asset_url }}" width="16" height="16" alt="" aria-hidden="true">
                </picture>
                <span class="promotion-banner__button-label">{{ section.settings.button_label | escape }}</span>
              </a>
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{%- comment -%}
  Section: WhatsApp CTA
  Usage: Sections -> Add section -> "WhatsApp CTA"
  Set the WhatsApp number (with country code) in the theme editor.
{%- endcomment -%}

{%- assign wa_number = section.settings.whatsapp_number | default: ''
  | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.' -%}
{%- assign wa_text = section.settings.default_message | strip | url_encode -%}
{%- assign wa_link = 'https://wa.me/' | append: wa_number -%}
{%- if wa_text != blank -%}
  {%- assign wa_link = wa_link | append: '?text=' | append: wa_text -%}
{%- endif -%}

<style>
  .wa-cta {
    padding: 24px 16px;
    text-align: {{ section.settings.alignment }};
  }
  .wa-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: #25D366;
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    padding: 15px 30px;
    border-radius: 10px;
    box-shadow: 0 6px 16px rgba(37, 211, 102, 0.30);
    transition: background-color var(--button-animation-duration) ease, transform var(--button-animation-duration) ease;
  }
  .wa-cta__btn:hover {
    background: #1da851;
    color: #ffffff;
    transform: translateY(-1px);
  }
  .wa-cta__btn svg {
    width: 22px;
    height: 22px;
    flex: 0 0 auto;
  }
  .wa-cta__hours {
    margin: 12px 0 0;
    font-size: 14px;
    color: #6b7280;
  }
  @media screen and (max-width: 480px) {
    .wa-cta__btn { width: 100%; padding: 15px 20px; }
  }
</style>

<div class="wa-cta" data-maxbuy-reveal="text">
  <a
    class="wa-cta__btn"
    href="{{ wa_link }}"
    target="_blank"
    rel="noopener"
    aria-label="{{ section.settings.button_text | escape }}"
  >
    <svg viewBox="0 0 24 24" fill="#ffffff" aria-hidden="true" focusable="false">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.71.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
    </svg>
    <span>{{ section.settings.button_text | escape }}</span>
  </a>

  {%- if section.settings.show_hours and section.settings.hours != blank -%}
    <p class="wa-cta__hours">{{ section.settings.hours | escape }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "WhatsApp CTA",
  "tag": "section",
  "class": "section-whatsapp-cta",
  "settings": [
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number (with country code)",
      "info": "Use digits only, e.g. 233241234567",
      "default": "233XXXXXXXXX"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Chat on WhatsApp"
    },
    {
      "type": "text",
      "id": "default_message",
      "label": "Pre-filled message",
      "info": "Message that opens inside WhatsApp",
      "default": "Hi Maxbuy, I'd like to track my order. My order number is: "
    },
    {
      "type": "checkbox",
      "id": "show_hours",
      "label": "Show availability hours",
      "default": true
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Availability text",
      "default": "Available Mon-Sat, 8:00 AM – 6:00 PM GMT"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "WhatsApp CTA"
    }
  ]
}
{% endschema %}

<span class="shop-by-brand__arrow-enabled" aria-hidden="true">
  <img class="shop-by-brand__svg-desktop" src="{{ 'brand-arrow-next.svg' | asset_url }}" width="{{ width }}" height="{{ height }}" alt="" loading="lazy">
  <img class="shop-by-brand__svg-mobile" src="{{ 'brand-arrow-next-mobile.svg' | asset_url }}" width="{{ mobile_width }}" height="{{ mobile_height }}" alt="" loading="lazy">
</span>
<span class="shop-by-brand__arrow-disabled" aria-hidden="true">
  <img class="shop-by-brand__svg-desktop" src="{{ 'brand-arrow-prev.svg' | asset_url }}" width="{{ width }}" height="{{ height }}" alt="" loading="lazy">
  <img class="shop-by-brand__svg-mobile" src="{{ 'brand-arrow-prev-mobile.svg' | asset_url }}" width="{{ mobile_width }}" height="{{ mobile_height }}" alt="" loading="lazy">
</span>

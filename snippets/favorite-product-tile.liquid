{%- liquid
  assign tile_product = block.settings.product
  assign tile_image = block.settings.featured_image | default: tile_product.featured_image | default: block.settings.image
  assign tile_title = block.settings.featured_title | default: tile_product.title | default: block.settings.title
  assign tile_link = tile_product.url | default: block.settings.button_link | default: block.settings.image_link
  assign tile_badge = block.settings.featured_badge
  assign tile_button = block.settings.featured_button | default: 'Shop Now'
  assign mobile_cart_asset = 'favorite-products-cart-mobile.svg'
  if index == 2 or index == 3
    assign mobile_cart_asset = 'favorite-products-cart-mobile-small.svg'
  endif
-%}
<article class="favorite-products__tile favorite-products__tile--{{ index }} media-hyperlink" data-maxbuy-reveal="card" data-maxbuy-order="{{ index | minus: 1 | modulo: 3 }}" {{ block.shopify_attributes }}>
  {% if tile_link != blank %}
    <a class="favorite-products__link" href="{{ tile_link }}" aria-labelledby="FavoriteProductTitle-{{ section.id }}-{{ block.id }}"></a>
  {% endif %}
  <div class="favorite-products__content">
    {% if tile_badge != blank %}
      <span class="favorite-products__badge"><span>{{ tile_badge | escape }}</span><img class="favorite-products__desktop-icon" src="{{ 'favorite-products-tag-tail.svg' | asset_url }}" width="4" height="4" alt="" loading="lazy"><img class="favorite-products__mobile-icon" src="{{ 'favorite-products-tag-tail-mobile.svg' | asset_url }}" width="1.71288" height="1.71288" alt="" loading="lazy"></span>
    {% endif %}
    <h3 id="FavoriteProductTitle-{{ section.id }}-{{ block.id }}" class="favorite-products__title">{{ tile_title | default: 'Select a product' | escape }}</h3>
    {% if tile_product != blank %}
      <div class="favorite-products__price">
        {% render 'price', product: tile_product, is_show_sale_label: false, price_class: 'favorite-products__current', compare_at_price_class: 'favorite-products__compare', show_b2b_price_label: block.settings.show_b2b_price_label %}
      </div>
    {% endif %}
    {% if tile_link != blank %}
      <span class="favorite-products__button"><img class="favorite-products__desktop-icon" src="{{ 'favorite-products-cart.svg' | asset_url }}" width="16" height="16" alt="" loading="lazy"><img class="favorite-products__mobile-icon" src="{{ mobile_cart_asset | asset_url }}" width="6.85153" height="6.85153" alt="" loading="lazy"><span>{{ tile_button | escape }}</span></span>
    {% elsif request.design_mode %}
      <span class="favorite-products__setup">Choose a product in this block.</span>
    {% endif %}
  </div>
  {% if tile_image != blank %}
    <div class="favorite-products__image">{{ tile_image | image_url: width: 900 | image_tag: class: 'anm-image-hover', widths: '200,300,450,600,900', sizes: '(min-width: 1200px) 300px, (min-width: 768px) 25vw, 50vw', loading: 'lazy', alt: tile_image.alt }}</div>
  {% elsif request.design_mode %}
    <div class="favorite-products__image favorite-products__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
  {% endif %}
</article>

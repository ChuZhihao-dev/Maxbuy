{% doc %}
  Displays the inventory status (in-stock, low-stock, out-of-stock, preorder) of a product variant.

  @param {object} variant - The product variant object
  @param {boolean} [is_show_preorder] - Flag to indicate if preorder status should be shown
  @param {boolean} [show_stock_indicator_bar] - Flag to show the visual stock indicator bar for low stock
  @param {boolean} [show_content_center] - Flag to center align the inventory content
  @param {string} [custom_class] - Custom CSS class for the inventory status container
  @param {string} [inventory_layout] - Use 'bar' for the product-page stock heading, bar and message
  @param {string} [stock_heading] - Heading for the bar layout
  @param {number} [stock_bar_capacity] - Stock quantity that fills the visual bar
  @param {string} [low_stock_text] - Low-stock fallback message for the bar layout; accepts {qty}

  @example
  {% render 'inventory-status',
    variant: current_variant, 
    is_show_preorder: true, 
    show_stock_indicator_bar: true, 
    show_content_center: false,
    custom_class: 'my-custom-class'
  %}
{% enddoc %}

{% liquid
  assign low_stock_threshold = settings.low_stock_threshold | plus: 0
  assign low_stock_message = settings.low_stock_message
  assign in_stock_message = settings.in_stock_message
  if customer != blank and customer.b2b?
    assign low_stock_threshold = settings.b2b_low_stock_threshold | plus: 0
    assign low_stock_message = settings.b2b_low_stock_message
    assign in_stock_message = settings.b2b_in_stock_message
  endif
  assign inventory_quantity = variant.inventory_quantity
  assign inventory_policy = variant.inventory_policy
  assign inventory_management = variant.inventory_management
  if inventory_layout == 'bar' and low_stock_message == blank
    assign low_stock_message = low_stock_text | default: 'Hurry, only {qty} items left in stock!'
    if inventory_quantity == 1
      assign low_stock_message = low_stock_message | replace: ' items ', ' item '
    endif
  endif
%}

{% liquid
  if is_show_preorder == true
    assign inventory_status = 'pre-order'
    assign inventory_text = settings.pre_order_status_label
    if inventory_text == blank
      assign inventory_text = 'products.product.inventory_status.in_stock' | t
    endif

  elsif inventory_management != 'shopify'
    assign inventory_status = 'in-stock'
    assign inventory_text = 'products.product.inventory_status.in_stock' | t

  elsif inventory_quantity > 0
    if inventory_quantity <= low_stock_threshold
      assign inventory_status = 'low-stock'
      assign inventory_text = low_stock_message
      if inventory_text != blank
        assign inventory_text = inventory_text | replace: '{qty}', inventory_quantity
      else
        assign inventory_text = 'products.product.inventory_status.low_stock' | t
      endif
    else
      assign inventory_status = 'in-stock'
      assign inventory_text = in_stock_message
      if inventory_text != blank
        assign inventory_text = inventory_text | replace: '{qty}', inventory_quantity
      else
        assign inventory_text = 'products.product.inventory_status.in_stock' | t
      endif
    endif

  elsif inventory_policy == 'continue'
    assign inventory_status = 'out-of-stock-continue-selling'
    assign inventory_text = settings.out_of_stock_continue_selling_label
    if inventory_text == blank
      assign inventory_text = 'products.product.inventory_status.out_of_stock_continue_selling' | t
    endif

  else
    assign inventory_status = 'out-of-stock'
    assign inventory_text = 'products.product.inventory_status.out_of_stock' | t
  endif
%}

{% if inventory_layout == 'bar' %}
  {% liquid
    assign show_inventory_bar = false
    if show_stock_indicator_bar and inventory_management == 'shopify'
      if inventory_status == 'low-stock' or inventory_status == 'in-stock' or inventory_status == 'out-of-stock'
        assign show_inventory_bar = true
      endif
    endif
    assign stock_bar_capacity = stock_bar_capacity | default: 20 | at_least: 1
    assign stock_bar_percentage = inventory_quantity | default: 0 | at_least: 0 | times: 100.0 | divided_by: stock_bar_capacity | at_most: 100
  %}
  <div
    class="product-info__inventory-status product-info__inventory-status--bar{% if show_content_center %} text-center{% endif %}"
    data-inventory-status="{{ inventory_status }}"
    role="status"
    aria-live="polite"
    aria-atomic="true"
  >
    <p class="product-info__stock-heading">{{ stock_heading | default: 'Stock:' | escape }}</p>
    {% if show_inventory_bar %}
      <div class="product-info__stock-track" aria-hidden="true">
        <div class="product-info__stock-fill" style="width: {{ stock_bar_percentage }}%;"></div>
      </div>
    {% endif %}
    <p class="product-info__stock-message">{{ inventory_text | escape }}</p>
  </div>
{% else %}
<div class="product-info__inventory-status anm-fade-element" data-fade-on-intersect data-inventory-status="{{ inventory_status }}">
  <span 
    class="product-info__inventory-label flex items-center gap-1.5
      {%- if custom_class != blank %} {{ custom_class -}}{% else %} text-medium{% endif -%}
      {%- if show_content_center %} justify-center{% endif -%}" 
    data-inventory-status="{{ inventory_status }}"
  >
    <span class="flex relative mr-1 ml-1">
      <span class="product-info__inventory-dot animate-ping absolute flex h-full w-full rounded-full opacity-75"></span>
      <span class="product-info__inventory-dot flex"></span>
    </span>
    <span>{{ inventory_text }}</span>
  </span>
</div>
{% endif %}

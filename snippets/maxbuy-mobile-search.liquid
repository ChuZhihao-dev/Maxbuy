<form class="maxbuy-mobile-menu__search" action="{{ routes.search_url }}" method="get" role="search">
  <button class="maxbuy-mobile-menu__search-submit" type="submit" aria-label="{{ 'general.search.search' | t }}">
    <img src="{{ 'maxbuy-mobile-search.svg' | asset_url }}" width="18" height="18" alt="">
  </button>
  <label class="sr-only" for="MaxbuyDrawerSearch-{{ section_id }}">{{ 'general.search.search' | t }}</label>
  <input id="MaxbuyDrawerSearch-{{ section_id }}" class="maxbuy-mobile-menu__search-input" type="search" name="q" placeholder="What Are You Looking For ?" value="{{ search.terms | escape }}">
  <input type="hidden" name="options[prefix]" value="last">
  <a class="maxbuy-mobile-menu__all-categories" href="{{ routes.all_products_collection_url }}">All Categories</a>
</form>

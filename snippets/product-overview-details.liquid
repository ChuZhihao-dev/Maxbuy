{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign has_details = false
  if product.variants.size > 1 or selected_variant.sku != blank or product.collections.size > 0 or product.tags.size > 0 or product.vendor != blank
    assign has_details = true
  endif
-%}
{%- if has_details -%}
  <div class="product-overview__details">
    {%- if product.variants.size > 1 -%}
      <product-overview-sku data-product-id="{{ product.id }}" data-label="{{ section.settings.sku_label | escape }}"{% if selected_variant.sku == blank %} hidden{% endif %}>{{ section.settings.sku_label | escape }}: {{ selected_variant.sku | escape }}</product-overview-sku>
      <script src="{{ 'product-overview-sku.js' | asset_url }}" defer></script>
    {%- elsif selected_variant.sku != blank -%}
      <span>{{ section.settings.sku_label | escape }}: {{ selected_variant.sku | escape }}</span>
    {%- endif -%}
    {%- if product.collections.size > 0 -%}
      <span>{{ section.settings.categories_label | escape }}:
        {% for product_collection in product.collections -%}
          <a href="{{ product_collection.url }}">{{ product_collection.title | escape }}</a>{% unless forloop.last %}, {% endunless %}
        {%- endfor -%}
      </span>
    {%- endif -%}
    {%- if product.tags.size > 0 -%}
      <span>{{ section.settings.tags_label | escape }}:
        {% for tag in product.tags -%}
          {%- assign tag_handle = tag | handleize -%}
          <a href="{{ routes.all_products_collection_url }}/{{ tag_handle }}">{{ tag | escape }}</a>{% unless forloop.last %}, {% endunless %}
        {%- endfor -%}
      </span>
    {%- endif -%}
    {%- if product.vendor != blank -%}
      <span>{{ section.settings.brand_label | escape }}: {{ product.vendor | link_to_vendor }}</span>
    {%- endif -%}
  </div>
{%- endif -%}

{%- liquid
  assign valid_count = 0
  assign column_count = columns | default: '2' | plus: 0
  for specification in specifications
    assign label = specification.label.value | strip
    assign value = specification.value.value | strip
    if label != blank and value != blank
      assign valid_count = valid_count | plus: 1
    endif
  endfor
  assign rows_per_column = valid_count | plus: column_count | minus: 1 | divided_by: column_count
-%}
{%- if valid_count > 0 -%}
  <div class="product-overview__specifications" data-columns="{{ column_count }}">
    {%- for column in (1..column_count) -%}
      {%- liquid
        assign range_start = column | minus: 1 | times: rows_per_column | plus: 1
        assign range_end = column | times: rows_per_column
        assign valid_index = 0
      -%}
      {%- if range_start <= valid_count -%}
        <table class="product-overview__table" aria-labelledby="{{ heading_id }}">
          <tbody>
            {%- for specification in specifications -%}
              {%- liquid
                assign label = specification.label.value | strip
                assign value = specification.value.value | strip
              -%}
              {%- if label != blank and value != blank -%}
                {%- assign valid_index = valid_index | plus: 1 -%}
                {%- if valid_index >= range_start and valid_index <= range_end -%}
                  <tr data-mobile-stripe="{{ valid_index | modulo: 2 }}">
                    <th scope="row">{{ label | escape }}</th>
                    <td>{{ value | escape }}</td>
                  </tr>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}
